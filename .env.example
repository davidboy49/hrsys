# Local dev database (docker compose up -d). On Vercel use the Neon pooled URL.
DATABASE_URL="postgresql://peopledesk:peopledesk@localhost:5433/peopledesk?schema=public"
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Leave empty locally: photos are saved under public/uploads. On Vercel Blob sets this automatically.
BLOB_READ_WRITE_TOKEN=""
