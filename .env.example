# Local dev database (docker compose up -d). On Vercel use the Neon pooled URL.
DATABASE_URL="postgresql://peopledesk:peopledesk@localhost:5433/peopledesk?schema=public"
AUTH_SECRET="generate-with: openssl rand -base64 32"

# Photo bucket (written by `neon deploy` into .env.local). Leave empty locally: photos save to public/uploads.
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
